# AegorynOS environment variable template
# Copy this file to .env.local for local development.
# Do not put real secret values in this file.

# App
NEXT_PUBLIC_APP_NAME=AegorynOS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public config
NEXT_PUBLIC_SUPABASE_URL=replace_with_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key

# Supabase private server config
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# AI provider
OPENAI_API_KEY=replace_with_openai_api_key
AI_MODEL=replace_with_model_name

# Usage credits
DEFAULT_MONTHLY_AI_CREDITS=100

# Payments - future use
RAZORPAY_KEY_ID=replace_later
RAZORPAY_KEY_SECRET=replace_later
STRIPE_SECRET_KEY=replace_later
STRIPE_WEBHOOK_SECRET=replace_later
